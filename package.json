{
  "name": "dreamro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/write-build-info.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "preview:worker": "npm run build && wrangler dev --port 8787",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/three": "^0.180.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.129.0"
  }
}
